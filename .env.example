# ============================================
# KickTV — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --------------------------------------------
# Stream Settings (Kick)
# --------------------------------------------
STREAM_URL=rtmps://fa723fc1b171.global-contribute.live-video.net/
STREAM_KEY=sk_us-west-2_Y8v6GGIQPT32_bhcH6HQGkp5Mt5PXaVO4sZaRUnvN2y

# --------------------------------------------
# Video Encoding
# --------------------------------------------
BITRATE=4500k
FPS=30
RESOLUTION=1920x1080
PRESET=veryfast
AUDIO_BITRATE=160k

# --------------------------------------------
# Dashboard
# --------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# --------------------------------------------
# Providers & API Keys
# --------------------------------------------
YOUTUBE_API_KEY=

PROVIDER_LOCAL_ENABLED=true
PROVIDER_UNLIMPLAY_ENABLED=true

PROVIDER_YOUTUBE_WEIGHT=20
PROVIDER_UNLIMPLAY_WEIGHT=80

# --------------------------------------------
# Queue Settings
# --------------------------------------------
QUEUE_MIN_SIZE=5
QUEUE_MAX_HISTORY=500
VIDEO_CACHE_DIR=data/videos
MAX_VIDEO_DURATION=3600
MIN_VIDEO_DURATION=10

# --------------------------------------------
# Database
# --------------------------------------------
DATABASE_PATH=data/db/kicktv.db

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO

# --------------------------------------------
# Auto-Start & Local Preview
# --------------------------------------------
AUTO_START=false
LOCAL_PREVIEW=false
