# ============================================
# KickTV — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================
# Stream Settings
# ============================================
# RTMP/RTMPS URL provided by Kick
STREAM_URL="srt://fa723fc1b171.srt.live-video.net:9000?streamid=sk_us-west-2_Y8v6GGIQPT32_bhcH6HQGkp5Mt5PXaVO4sZaRUnvN2y&passphrase=FolcGot7y0QOSV492RMT1xIybMVwVXMEpPrt2yDUjxsO7SRyUn69ZhhE7BCL2sYVjOstznKWBkATXst"

# Your secret stream key
STREAM_KEY=

# --------------------------------------------
# Video Encoding
# --------------------------------------------
BITRATE=2500k
FPS=30
RESOLUTION=1280x720
PRESET=ultrafast
AUDIO_BITRATE=128k

# --------------------------------------------
# Dashboard
# --------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# --------------------------------------------
# Provider API Keys
# --------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --------------------------------------------
# Provider Toggle (true/false)
# --------------------------------------------
PROVIDER_LOCAL_ENABLED=false
PROVIDER_PEXELS_ENABLED=false
PROVIDER_PIXABAY_ENABLED=false
PROVIDER_ARCHIVE_ENABLED=false
PROVIDER_YOUTUBE_ENABLED=true
PROVIDER_REDDIT_ENABLED=false
PROVIDER_UNLIMPLAY_ENABLED=true

# --------------------------------------------
# Queue Settings
# --------------------------------------------
QUEUE_MIN_SIZE=5
QUEUE_MAX_HISTORY=500
VIDEO_CACHE_DIR=data/videos
MAX_VIDEO_DURATION=14400
MIN_VIDEO_DURATION=10

# --------------------------------------------
# Database
# --------------------------------------------
DATABASE_PATH=data/db/kicktv.db

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO

# --------------------------------------------
# Auto-Start (for Google Colab / headless)
# --------------------------------------------
AUTO_START=true
